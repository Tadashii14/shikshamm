{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Location": "https://attendai-api.onrender.com/$1"
      },
      "status": 307
    },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "installCommand": "pip install -r requirements-vercel.txt",
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}


