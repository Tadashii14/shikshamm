{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://attendai-api.onrender.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://attendai-api.onrender.com/:path*",
      "permanent": false
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "installCommand": "pip install -r requirements-vercel.txt",
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}


